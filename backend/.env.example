# Copy to backend/.env (never commit .env). Real values for production:
DJANGO_SECRET_KEY=            # 50+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_DEBUG=0                # 1 only on your own computer
DJANGO_ALLOWED_HOSTS=schools.example.org
DJANGO_HTTPS=1                # behind HTTPS: secure cookies, HSTS, redirect
CORS_ORIGINS=https://schools.example.org
DB_NAME=musabe
DB_USER=musabe
DB_PASSWORD=
DB_HOST=127.0.0.1
LOGIN_RATE=10/min
